
###read all products
GET http://localhost:4000/product-api/products

###read products by id 
GET http://localhost:4000/product-api/products/2


###create new product
POST http://localhost:4000/product-api/products
Content-Type: application/json

{
    "productId":2,
    "productName":"tablet",
    "price":25000,
    "brand":"samsung"
}

###update a product by ID
PUT http://localhost:4000/product-api/products/2

Content-Type: application/json

   {
    "productId":2,
    "productName":"Refrigerator",
    "price":30000,
    "brand":"LG"
}

###delete product by id 
DELETE http://localhost:4000/product-api/products/2


